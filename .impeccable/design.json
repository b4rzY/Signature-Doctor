  "narrative": {
    "northStar": "Keep noir, elevate the craft",
    "overview": "Keep noir, elevate the craft. A charcoal operational workbench uses quiet tonal layers, locally served Manrope, and restrained lime to make actions and selected evidence easy to find. Monospace separates addresses, patterns, deltas, and counts from interface language.\n\nThis records the implemented source in public/styles.css and public/app.mjs. Desktop and mobile browser captures are available in .impeccable/review. This document records the final source changes; the final visual review verdict is tracked separately.",
    "keyCharacteristics": [
      "Charcoal tonal layers.",
      "Restrained lime actions and focus.",
      "Manrope interface language with monospace evidence.",
      "Dense operational layout with an adjacent inspector."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Semantic colors must accompany a label or icon that identifies the underlying state.",
        "section": "colors"
      },
      {
        "name": "The Data Voice Rule",
        "body": "Use mono for machine evidence and the sans family for human instructions.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use tonal layers and rules for persistent workspace depth; reserve the implemented shadows for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reserve lime for primary actions, focus, selection, and current evidence.",
      "Do use monospace for machine data and Manrope for interface language.",
      "Do pair status color with a label or icon.",
      "Do retain the reduced-motion override and visible keyboard focus."
    ],
    "donts": [
      "Don't use status colors as decorative accents.",
      "Don't present simulated data as live evidence.",
      "Don't treat source inspection as a successful visual review."
    ]
  }
